<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#1d4ed8">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <title>Cadastro - Gestante</title>
  <link rel="stylesheet" href="/style.css">
  <script src="/pwa.js" defer></script>
</head>
<body>
  <div class="login-container">
    <form class="login-card" method="POST" action="/cadastro">
      <h1>Criar conta</h1>
      <p>Cadastre-se para iniciar o acompanhamento da sua gestação.</p>

      <% if (error) { %>
        <div class="alert error"><%= error %></div>
      <% } %>

      <% if (success) { %>
        <div class="alert success"><%= success %></div>
      <% } %>

      <label for="name">Nome</label>
      <input type="text" id="name" name="name" required value="<%= values.name %>" aria-describedby="<%= fieldErrors.name ? 'name-error' : '' %>">
      <% if (fieldErrors.name) { %><p class="field-error" id="name-error"><%= fieldErrors.name %></p><% } %>

      <label for="email">E-mail</label>
      <input type="email" id="email" name="email" required value="<%= values.email %>" aria-describedby="<%= fieldErrors.email ? 'email-error' : '' %>">
      <% if (fieldErrors.email) { %><p class="field-error" id="email-error"><%= fieldErrors.email %></p><% } %>

      <label for="password">Senha</label>
      <input type="password" id="password" name="password" required aria-describedby="<%= fieldErrors.password ? 'password-error' : '' %>">
      <% if (fieldErrors.password) { %><p class="field-error" id="password-error"><%= fieldErrors.password %></p><% } %>

      <label for="confirmPassword">Confirmar senha</label>
      <input type="password" id="confirmPassword" name="confirmPassword" required aria-describedby="<%= fieldErrors.confirmPassword ? 'confirm-password-error' : '' %>">
      <% if (fieldErrors.confirmPassword) { %><p class="field-error" id="confirm-password-error"><%= fieldErrors.confirmPassword %></p><% } %>

      <button type="submit">Cadastrar</button>

      <div class="helper-text">
        <p>Já tem conta? <a href="/login">Faça login</a></p>
      </div>
    </form>
  </div>
</body>
</html>
