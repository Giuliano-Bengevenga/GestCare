<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#1d4ed8">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <title>Avaliação de risco - GestCare</title>
  <link rel="stylesheet" href="/style.css">
  <script src="/pwa.js" defer></script>
  <script src="/risk-choices.js" defer></script>
</head>
<body>
  <% const checked = (field, option) => { const selected = Array.isArray(values[field]) ? values[field] : [values[field]]; return selected.includes(option) ? 'checked' : ''; }; %>
  <% const fieldError = (field) => fieldErrors[field] || ''; %>
  <% const textoDaQuestao = (chave, padrao) => (questoes || []).find((questao) => questao.chave === chave)?.pergunta || padrao; %>
  <% const camposDaEtapaDois = ['sangramento', 'perdaLiquido', 'dorAbdominalForte', 'sintomasPressaoAlta', 'sintomaGrave', 'movimentosReduzidos', 'febre']; %>
  <% const etapaInicial = camposDaEtapaDois.some((field) => fieldErrors[field]) ? 2 : 1; %>

  <div class="container-fluid">
    <div class="row">
      <%- include('partials/sidebar', { user: user, activePage: 'avaliacao-risco' }) %>

      <main>
        <header class="header">
          <div>
            <h1>Avaliação de risco gestacional</h1>
            <p>Responda com atenção. As informações ajudam a identificar situações que precisam de acompanhamento.</p>
          </div>
          <div class="usuario">
            <span class="avatar" aria-hidden="true"><%= (user.name || 'U').trim().charAt(0).toUpperCase() %></span>
            <span>Olá, <%= user.name %></span>
          </div>
        </header>

        <form class="risk-assessment-card" data-risk-form data-initial-step="<%= etapaInicial %>" method="POST" action="/avaliacao-risco">
          <div class="risk-form-intro">
            <span class="share-eyebrow">Questionário de saúde</span>
            <h2>Condições de saúde e sinais de alerta</h2>
            <p>Nos itens com seleção múltipla, marque todas as opções que se aplicam. “Nenhuma” não pode ser combinada com outra resposta.</p>
          </div>

          <% if (error) { %>
            <div class="alert error"><%= error %></div>
          <% } %>

          <aside class="emergency-guidance" role="note" aria-labelledby="emergency-guidance-title">
            <div>
              <h2 id="emergency-guidance-title">Precisa de ajuda agora?</h2>
              <p>Este questionário não substitui atendimento. Se a situação parecer urgente, procure uma maternidade ou pronto atendimento. Em emergência, ligue para o SAMU.</p>
            </div>
            <a href="tel:192">Ligar 192</a>
          </aside>

          <div class="risk-progress" aria-label="Progresso da avaliação">
            <span class="risk-progress-label" data-risk-progress role="status" aria-live="polite">Etapa 1 de 2</span>
            <div class="risk-progress-track" aria-hidden="true"><span data-risk-progress-bar></span></div>
          </div>

          <section class="risk-section risk-step" data-risk-step="1" aria-labelledby="historico-title">
            <h3 id="historico-title">Histórico e condições de saúde</h3>

            <fieldset class="risk-question">
              <legend>1. <%= textoDaQuestao('gestacaoMultipla', 'Você está grávida de gêmeos ou mais bebês?') %></legend>
              <div class="risk-options">
                <% ['Sim', 'Não', 'Não sei'].forEach((option) => { %>
                  <label class="risk-option"><input type="radio" name="gestacaoMultipla" value="<%= option %>" <%= checked('gestacaoMultipla', option) %> required><span><%= option %></span></label>
                <% }); %>
              </div>
              <% if (fieldError('gestacaoMultipla')) { %><p class="field-error"><%= fieldError('gestacaoMultipla') %></p><% } %>
            </fieldset>

            <fieldset class="risk-question">
              <legend>2. <%= textoDaQuestao('condicoesSaude', 'Você possui alguma destas condições de saúde?') %></legend>
              <p class="risk-hint">Selecione todas as opções aplicáveis.</p>
              <div class="risk-options risk-options-grid">
                <% ['Pressão alta', 'Diabetes', 'Doença cardíaca', 'Doença renal', 'Epilepsia', 'Doença autoimune', 'Outra doença crônica', 'Nenhuma'].forEach((option) => { %>
                  <label class="risk-option"><input type="checkbox" name="condicoesSaude" value="<%= option %>" <%= checked('condicoesSaude', option) %>><span><%= option %></span></label>
                <% }); %>
              </div>
              <% if (fieldError('condicoesSaude')) { %><p class="field-error"><%= fieldError('condicoesSaude') %></p><% } %>
            </fieldset>

            <fieldset class="risk-question">
              <legend>3. <%= textoDaQuestao('condicoesAtuais', 'Durante esta gestação, algum profissional informou que você apresenta uma destas condições?') %></legend>
              <p class="risk-hint">Selecione todas as opções aplicáveis.</p>
              <div class="risk-options risk-options-grid">
                <% ['Pressão alta ou pré-eclâmpsia', 'Diabetes gestacional', 'Anemia grave', 'Infecção que necessita de acompanhamento', 'Alteração na placenta', 'Alteração no crescimento do bebê', 'Nenhuma'].forEach((option) => { %>
                  <label class="risk-option"><input type="checkbox" name="condicoesAtuais" value="<%= option %>" <%= checked('condicoesAtuais', option) %>><span><%= option %></span></label>
                <% }); %>
              </div>
              <% if (fieldError('condicoesAtuais')) { %><p class="field-error"><%= fieldError('condicoesAtuais') %></p><% } %>
            </fieldset>

            <fieldset class="risk-question">
              <legend>4. <%= textoDaQuestao('complicacoesAnteriores', 'Você já teve alguma complicação em uma gestação anterior?') %></legend>
              <p class="risk-hint">Selecione todas as opções aplicáveis.</p>
              <div class="risk-options risk-options-grid">
                <% ['Parto prematuro', 'Pré-eclâmpsia ou pressão alta', 'Diabetes gestacional', 'Aborto recorrente', 'Óbito fetal ou neonatal', 'Hemorragia grave', 'Não tive gestação anterior', 'Nenhuma complicação'].forEach((option) => { %>
                  <label class="risk-option"><input type="checkbox" name="complicacoesAnteriores" value="<%= option %>" <%= checked('complicacoesAnteriores', option) %>><span><%= option %></span></label>
                <% }); %>
              </div>
              <% if (fieldError('complicacoesAnteriores')) { %><p class="field-error"><%= fieldError('complicacoesAnteriores') %></p><% } %>
            </fieldset>

            <fieldset class="risk-question">
              <legend>5. <%= textoDaQuestao('usoSubstancias', 'Você usa cigarro, bebida alcoólica ou outras drogas durante a gestação?') %></legend>
              <div class="risk-options">
                <% ['Sim', 'Não', 'Prefiro não responder'].forEach((option) => { %>
                  <label class="risk-option"><input type="radio" name="usoSubstancias" value="<%= option %>" <%= checked('usoSubstancias', option) %> required><span><%= option %></span></label>
                <% }); %>
              </div>
              <% if (fieldError('usoSubstancias')) { %><p class="field-error"><%= fieldError('usoSubstancias') %></p><% } %>
            </fieldset>

            <fieldset class="risk-question">
              <legend>6. <%= textoDaQuestao('medicamentoSemOrientacao', 'Você está tomando algum medicamento sem orientação de um profissional de saúde?') %></legend>
              <div class="risk-options">
                <% ['Sim', 'Não'].forEach((option) => { %>
                  <label class="risk-option"><input type="radio" name="medicamentoSemOrientacao" value="<%= option %>" <%= checked('medicamentoSemOrientacao', option) %> required><span><%= option %></span></label>
                <% }); %>
              </div>
              <% if (fieldError('medicamentoSemOrientacao')) { %><p class="field-error"><%= fieldError('medicamentoSemOrientacao') %></p><% } %>
            </fieldset>
            <div class="risk-step-actions">
              <button class="risk-next" data-risk-next type="button">Continuar</button>
            </div>
          </section>

          <section class="risk-section risk-step" data-risk-step="2" aria-labelledby="alertas-title">
            <h3 id="alertas-title">Sintomas atuais e sinais de alerta</h3>

            <fieldset class="risk-question">
              <legend>7. <%= textoDaQuestao('sangramento', 'Você está apresentando sangramento vaginal?') %></legend>
              <div class="risk-options">
                <% ['Não', 'Pequena quantidade', 'Sangramento intenso'].forEach((option) => { %>
                  <label class="risk-option"><input type="radio" name="sangramento" value="<%= option %>" <%= checked('sangramento', option) %> required><span><%= option %></span></label>
                <% }); %>
              </div>
              <% if (fieldError('sangramento')) { %><p class="field-error"><%= fieldError('sangramento') %></p><% } %>
            </fieldset>

            <fieldset class="risk-question">
              <legend>8. <%= textoDaQuestao('perdaLiquido', 'Você está com perda de líquido pela vagina, como se a bolsa tivesse rompido?') %></legend>
              <div class="risk-options">
                <% ['Sim', 'Não', 'Não sei'].forEach((option) => { %>
                  <label class="risk-option"><input type="radio" name="perdaLiquido" value="<%= option %>" <%= checked('perdaLiquido', option) %> required><span><%= option %></span></label>
                <% }); %>
              </div>
              <% if (fieldError('perdaLiquido')) { %><p class="field-error"><%= fieldError('perdaLiquido') %></p><% } %>
            </fieldset>

            <fieldset class="risk-question">
              <legend>9. <%= textoDaQuestao('dorAbdominalForte', 'Você está sentindo dor forte ou persistente na barriga?') %></legend>
              <div class="risk-options">
                <% ['Sim', 'Não'].forEach((option) => { %>
                  <label class="risk-option"><input type="radio" name="dorAbdominalForte" value="<%= option %>" <%= checked('dorAbdominalForte', option) %> required><span><%= option %></span></label>
                <% }); %>
              </div>
              <% if (fieldError('dorAbdominalForte')) { %><p class="field-error"><%= fieldError('dorAbdominalForte') %></p><% } %>
            </fieldset>

            <fieldset class="risk-question">
              <legend>10. <%= textoDaQuestao('sintomasPressaoAlta', 'Você está com dor de cabeça intensa, visão embaçada, pontos luminosos ou dor forte na parte superior da barriga?') %></legend>
              <div class="risk-options">
                <% ['Sim', 'Não'].forEach((option) => { %>
                  <label class="risk-option"><input type="radio" name="sintomasPressaoAlta" value="<%= option %>" <%= checked('sintomasPressaoAlta', option) %> required><span><%= option %></span></label>
                <% }); %>
              </div>
              <% if (fieldError('sintomasPressaoAlta')) { %><p class="field-error"><%= fieldError('sintomasPressaoAlta') %></p><% } %>
            </fieldset>

            <fieldset class="risk-question">
              <legend>11. <%= textoDaQuestao('sintomaGrave', 'Você teve convulsão, desmaio, falta de ar intensa ou dor no peito?') %></legend>
              <div class="risk-options">
                <% ['Sim', 'Não'].forEach((option) => { %>
                  <label class="risk-option"><input type="radio" name="sintomaGrave" value="<%= option %>" <%= checked('sintomaGrave', option) %> required><span><%= option %></span></label>
                <% }); %>
              </div>
              <% if (fieldError('sintomaGrave')) { %><p class="field-error"><%= fieldError('sintomaGrave') %></p><% } %>
            </fieldset>

            <fieldset class="risk-question">
              <legend>12. <%= textoDaQuestao('movimentosReduzidos', 'Se você já sente o bebê se movimentar, percebeu diminuição ou ausência dos movimentos?') %></legend>
              <div class="risk-options">
                <% ['Sim', 'Não', 'Ainda não sinto os movimentos', 'Não sei avaliar'].forEach((option) => { %>
                  <label class="risk-option"><input type="radio" name="movimentosReduzidos" value="<%= option %>" <%= checked('movimentosReduzidos', option) %> required><span><%= option %></span></label>
                <% }); %>
              </div>
              <% if (fieldError('movimentosReduzidos')) { %><p class="field-error"><%= fieldError('movimentosReduzidos') %></p><% } %>
            </fieldset>

            <fieldset class="risk-question">
              <legend>13. <%= textoDaQuestao('febre', 'Você está com febre de 38 °C ou mais?') %></legend>
              <div class="risk-options">
                <% ['Sim', 'Não', 'Não medi a temperatura'].forEach((option) => { %>
                  <label class="risk-option"><input type="radio" name="febre" value="<%= option %>" <%= checked('febre', option) %> required><span><%= option %></span></label>
                <% }); %>
              </div>
              <% if (fieldError('febre')) { %><p class="field-error"><%= fieldError('febre') %></p><% } %>
            </fieldset>
            <div class="risk-step-actions risk-final-actions">
              <button class="risk-back" data-risk-back type="button">Voltar</button>
              <button class="risk-submit" type="submit">Salvar avaliação de risco</button>
            </div>
          </section>
        </form>
      </main>
    </div>
  </div>
</body>
</html>
