<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#1d4ed8">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <title>Dados da gestação - Gestante</title>
  <link rel="stylesheet" href="/style.css">
  <script src="/pwa.js" defer></script>
</head>
<body>
  <main class="login-container">
    <form class="login-card" method="POST" action="/dados-gestacao">
      <h1>Dados da gestação</h1>
      <p>Informe os dados para iniciar o seu acompanhamento.</p>

      <% if (error) { %>
        <div class="alert error"><%= error %></div>
      <% } %>

      <label for="nome">Nome completo</label>
      <input type="text" id="nome" name="nome" maxlength="150" required value="<%= values.nome || '' %>" aria-describedby="<%= fieldErrors.nome ? 'nome-error' : '' %>">
      <% if (fieldErrors.nome) { %><p class="field-error" id="nome-error"><%= fieldErrors.nome %></p><% } %>

      <label for="cpf">CPF</label>
      <input type="text" id="cpf" name="cpf" inputmode="numeric" maxlength="14" placeholder="000.000.000-00" required value="<%= values.cpf || '' %>" aria-describedby="<%= fieldErrors.cpf ? 'cpf-error' : '' %>">
      <% if (fieldErrors.cpf) { %><p class="field-error" id="cpf-error"><%= fieldErrors.cpf %></p><% } %>

      <label for="dataNascimento">Data de nascimento</label>
      <input type="date" id="dataNascimento" name="dataNascimento" required value="<%= values.dataNascimento || '' %>" aria-describedby="<%= fieldErrors.dataNascimento ? 'data-nascimento-error' : '' %>">
      <% if (fieldErrors.dataNascimento) { %><p class="field-error" id="data-nascimento-error"><%= fieldErrors.dataNascimento %></p><% } %>

      <label for="dum">Data da última menstruação (DUM)</label>
      <input type="date" id="dum" name="dum" value="<%= values.dum || '' %>" aria-describedby="<%= fieldErrors.dum ? 'dum-error' : '' %>">
      <% if (fieldErrors.dum) { %><p class="field-error" id="dum-error"><%= fieldErrors.dum %></p><% } %>

      <button type="submit">Cadastrar gestação</button>
      <div class="helper-text"><p><a href="/situacao-gestacao">Voltar</a></p></div>
    </form>
  </main>
</body>
</html>
